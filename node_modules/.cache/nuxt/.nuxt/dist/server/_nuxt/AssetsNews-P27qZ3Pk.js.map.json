 slug: {\n    type: String,\n  },\n  text: {\n    type: String,\n  },\n});\n\nconst formatDate = (isoString) => {\n  const date = new Date(isoString);\n  \n  const months = [\n    'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',\n    'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'\n  ];\n  \n  const day = date.getUTCDate();\n  const month = months[date.getUTCMonth()];\n  const year = date.getUTCFullYear();\n  \n  return `${day} ${month} ${year}`;\n}\n</script>\n\n<template>\n  <NuxtLinkLocale\n    class=\"assets-news\"\n    :to=\"`/media/${slug}`\"\n  >\n    <div class=\"assets-news__left\">\n      <Text\n        tag=\"span\"\n        :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SMALL_20]\"\n        :color=\"$color.GRAY\"\n      >{{ formatDate(date) }}</Text>\n    </div>\n    <div class=\"assets-news__right\">\n      <Text\n        tag=\"span\"\n        :variant=\"[$typographyVariant.T_BIG_24_MOB, $typographyVariant.T_BIG_36]\"\n        :color=\"$color.BLACK\"\n      >{{ text }}</Text>\n    </div>\n    <IconSvg\n      :name=\"$iconName.ARROW_UP\" \n      :size=\"[$iconSize.LARGE, $iconSize.LARGE_MOB]\"\n      class=\"assets-news__arrow\"\n    />\n  </NuxtLinkLocale>\n</template>\n\n<style lang=\"scss\" scoped>\n.assets-news {\n  display: block;\n  background-color: var(--color-WHITE);\n  position: relative;\n  padding: em(20) 0 em(25);\n  overflow: hidden;\n  @include mq('desktop') {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: flex-start;\n    padding: em(60) 0;\n  }\n  &::after {\n    content: '';\n    position: absolute;\n    height: 1px;\n    left: 0;\n    top: 0;\n    width: 100%;\n    background-color: var(--color-GRAY_LINE);\n    @include mq('desktop') {\n      transform: translateX(calc(630/1860 * 100%));\n      transition: transform .3s linear;\n    }\n  }\n  &:last-child::before {\n    content: '';\n    position: absolute;\n    height: 1px;\n    left: 0;\n    bottom: 0;\n    width: 100%;\n    background-color: var(--color-GRAY_LINE);\n    @include mq('desktop') {\n      transform: translateX(calc(630/1860 * 100%));\n      transition: transform .3s linear;\n    }\n  }\n  &:hover {\n    &::after {\n      transform: translateX(0);\n    }\n    + .assets-news::after {\n      transform: translateX(0);\n    }\n    &:last-child::before {\n      transform: translateX(0);\n    }\n    .assets-news__arrow {\n      @include mq('desktop') {\n        transition: transform .5s linear, opacity .5s linear;\n        transform: translateY(-50%) translateX(0);\n        opacity: 1;\n      }\n    }\n  }\n}\n\n.assets-news__left {\n  padding-bottom: em(12);\n  @include mq('desktop') {\n    padding-left: calc(315/1860 * 100%);\n    padding-bottom: 0;\n    padding-top: em(10);\n    width: calc(630/1860 * 100%);\n  }\n}\n.assets-news__right {\n  @include mq('desktop') {\n    width: calc(1230/1860 * 100%);\n  }\n}\n.assets-news__arrow {\n  display: none;\n  @include mq('desktop') {\n    display: block;\n    position: absolute;\n    top: 50%;\n    transform: translateY(-50%) translateX(em(230));\n    left: 0;\n    opacity: 0;\n  }\n}\n</style>"],"version":3}