A,EAAoB,GAAA,MAAA,OAAA,CAAA;;;QAG/C,MAAK;AAAA,QACL,MAAK;AAAA;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","$typographyVariant","$font","_push","_parent","_ssrInterpolate","_createTextVNode","_toDisplayString","_ssrRenderList","index","_withAsyncContext","_ssrRenderComponent","_unref"],"sources":["../../../../../../../app/components/sections/HomePreviewSections.vue","../../../../../../../app/pages/index.vue"],"sourcesContent":["<script setup>\nconst props = defineProps({\n  introData: {\n    type: Object,\n    default: []\n  },\n})\n</script>\n\n<template>\n  <div class=\"preview\">\n    <div class=\"preview__header\">\n      <Text \n        tag=\"h1\"\n        :variant=\"[$typographyVariant.T_H2_50_MOB, $typographyVariant.T_H2_100]\"\n        :font=\"$font.MAREGRAPHE_REGULAR\"\n      >{{introData?.name}}</Text>\n    </div>\n    <div class=\"preview__content\">\n      <!--видео-->\n      <template v-if=\"introData?.properties?.type === 'video'\">\n        <video \n          autoplay muted loop playsinline=\"\"\n          class=\"preview__video\"\n          v-for=\"(video, index) in introData?.media?.video\"\n          :key=\"index\"\n        >\n          <source\n            :src=\"video.src\"\n            type=\"video/mp4\"\n          >\n          <source\n            :src=\"video.src\"\n            type=\"video/webm\"\n          >\n        </video>\n      </template>\n      <!--END видео-->\n\n      <!--картинка-->\n      <template v-if=\"introData?.properties?.type === 'image'\">\n        <img\n          v-for=\"(image, index) in introData?.media?.image\"\n          class=\"preview__image\"\n          :src=\"image.src\" \n          :alt=\"image.alt\"  \n          :key=\"index\"\n        >\n      </template>\n      <!--END картинка-->\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .preview {\n    min-height: 100vh;\n    display: flex;\n    align-items: center;\n    width: 100%;\n    height: 100%;\n  }\n\n  .preview__header {\n    position: absolute;\n    z-index: 1;\n    bottom: em(100);\n    left: em(10);\n    max-width: em(270);\n    opacity: .8;\n    @include mq('desktop') {\n      bottom: em(66);\n      left: em(30);\n      max-width: em(450);\n    }\n  }\n\n  .preview__video, .preview__image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    position: absolute;\n    top: 0;\n    left: 0;\n    will-change: transform;\n    opacity: .7;\n  }\n</style>\n","<script setup>\n//Загрузка данных для видео на главной и блок интро\nconst siteStore = useSiteStore()\nconst { homePageData } = storeToRefs(siteStore)\nconst { data } = await useAsyncData('homepageDataInit', () => siteStore.fetchHomepage())\n// Загрузка данных для первых 12 новостей\nconst newsStore = useNewsStore()\nconst { newsListSlider } = storeToRefs(newsStore)\nawait useAsyncData('initialNewsSlider', () => newsStore.fetchInitialSlider())\n//данные для аккардеона из стора\nconst partnerStore = usePartnerStore()\nconst { categoriesWithAssets } = storeToRefs(partnerStore)\n</script>\n\n<template>\n  <div class=\"home\">\n    <div class=\"home__preview container-full-under-header\">\n      <HomePreviewSections :introData=\"homePageData\" />\n    </div>\n\n    <!--BlockIntro-->\n    <div class=\"home__intro\" v-if=\"homePageData?.properties?.description\">\n      <div class=\"home__intro-text container-indent-left\">\n        <Text\n          :variant=\"[$typographyVariant.T_SUPER_BIG_27_MOB, $typographyVariant.T_SUPER_BIG_50]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n        >{{ siteStore?.homePageData?.properties?.description }}</Text>\n      </div>\n      <div class=\"home__intro-link\">\n        <Links \n          link=\"/about\" \n          text=\"О нас\"\n        />\n      </div>\n    </div>\n    <!--EndBlockIntro-->\n\n    <div class=\"home__line container-full\" />\n\n    <!--BlockSlider-->\n    <div class=\"home__news\">\n      <div class=\"home__news-header\">\n        <Text \n          tag=\"h2\"\n          :variant=\"[$typographyVariant.T_H0_60_MOB, $typographyVariant.T_H0_250]\"\n          :font=\"$font.MAREGRAPHE_REGULAR\"\n        >Новости</Text>\n      </div>\n      <div class=\"container-full\">\n        <SliderBasic\n          v-if=\"newsListSlider\"\n          :slides=\"newsListSlider\"\n          :slides-per-view=\"3\"\n          :slides-per-group=\"3\"\n          :autoplay=\"true\"\n          loop\n        />\n      </div>\n      <div class=\"home__news-link\">\n        <Links \n          link=\"/media\" \n          text=\"Все новости\"\n        />\n      </div>\n    </div>\n    <!--EndBlockSlider-->\n\n    <!--BlockAssets-->\n    <div class=\"home__assets\">\n      <div class=\"home__assets-header\">\n        <Text \n          tag=\"h2\"\n          :variant=\"[$typographyVariant.T_H0_60_MOB, $typographyVariant.T_H0_250]\"\n          :font=\"$font.MAREGRAPHE_REGULAR\"\n        >Активы</Text>\n      </div>\n      <div class=\"home__assets-accordion\">\n        <Collapse :categoriesData=\"categoriesWithAssets\" />\n      </div>\n      <Links \n        link=\"/business\" \n        text=\"Все активы холдинга\"\n      />\n    </div>\n    <!--EndBlockAssets-->\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .home {\n    margin-bottom: em(100);\n    @include mq('desktop') {\n      margin-bottom: em(150);\n    }\n  }\n\n  .home__line {\n    width: auto;\n    height: 1px;\n    background-color: var(--color-GRAY_LINE);\n  }\n\n  .home__intro-text {\n    margin-top: em(70);\n    margin-bottom: em(80);\n    @include mq('desktop') {\n      margin-top: em(150);\n      margin-bottom: em(155);\n    }\n  }\n\n  .home__intro-link {\n    margin-bottom: em(80);\n    @include mq('desktop') {\n      margin-bottom: em(150);\n    }\n  }\n\n  .home__news {\n    position: relative;\n  }\n\n  .home__news-header {\n    margin: em(60) 0 em(60) 0;\n    @include mq('desktop') {\n      margin: em(140) 0 em(170) 0;\n    }\n  }\n\n  .home__news-link {\n    margin-top: em(120);\n    @include mq('desktop') {\n      margin-top: 0;\n      position: absolute;\n      right: 0;\n      top: em(150);\n    }\n  }\n\n  .home__assets-header {\n    margin-top: em(120);\n    margin-bottom: em(60);\n    @include mq('desktop') {\n      margin-top: em(255);\n      margin-bottom: em(190);\n    }\n  }\n\n  .home__assets-accordion {\n    margin-bottom: em(80);\n    @include mq('desktop') {\n      margin-bottom: em(190);\n    }\n  }\n</style>\n"],"version":3}