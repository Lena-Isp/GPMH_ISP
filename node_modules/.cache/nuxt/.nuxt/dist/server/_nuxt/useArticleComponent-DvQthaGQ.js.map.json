ents/shell/ContainerSplit.vue","../../../../../../../app/components/elements/ArticleQuote.vue","../../../../../../../app/components/elements/ArticleText.vue","../../../../../../../app/components/elements/ArticleImage.vue","../../../../../../../app/components/elements/ArticleSlider.vue","../../../../../../../app/components/elements/ArticleVideo.vue","../../../../../../../app/components/elements/ArticleRutube.vue","../../../../../../../app/composables/useArticleComponent.js"],"sourcesContent":["<script setup>\nconst props = defineProps({\n  visibleBottom: {\n    type: Boolean,\n    default: true\n  },\n});\n\nconst networksNew = [\n  { link: 'https://t.me/tv3russia', title: 'Telegram' },\n  { link: 'https://vk.com/kanal_tv3', title: 'ВКонтакте' },\n  { link: 'https://vk.com/kanal_tv3', title: 'Одноклассники' },\n];\n</script>\n\n<template>\n<div :class=\"['container-split', { 'container-split--news': visibleBottom }]\">\n  <div class=\"container-split__content\" >\n    <div class=\"container-split__content-top\">\n      <slot name=\"content\" />\n    </div>\n    <!--Блок с тегами и второй соцсетью-->\n    <template v-if=\"visibleBottom\">\n      <div class=\"container-split__bottom-tags\">\n        <span class=\"container-split__text\">\n          {{ $t('containerSplit.tags') }}\n        </span>\n        Партнерство\n      </div>\n      <div class=\"container-split__bottom-soc\">\n        <span class=\"container-split__text\">\n          {{ $t('containerSplit.soc') }}\n        </span>\n        <SocialList\n          :socials=\"networksNew\"\n          :color=\"$color.GRAY\"\n          mode=\"share\"\n        />\n      </div>\n    </template>\n    <!--END Блок с тегами и второй соцсетью-->\n  </div>\n  <div :class=\"['container-split__sidebar', { 'container-split__sidebar--news': visibleBottom }]\" >\n    <slot name=\"sidebar\" />\n  </div>\n</div>\n</template>\n\n<style lang=\"scss\" scoped>\n.container-split {\n  display: flex;\n  flex-direction: column;\n  @include mq('desktop') {\n    flex-direction: row-reverse;\n    flex-wrap: wrap;\n    margin-top: em(90);\n  }\n  &--news {\n    margin-top: em(180);\n  }\n}\n\n.container-split__content {\n  flex-grow: 1;\n  @include mq('desktop') {\n    width: calc(1230/1860 * 100%);\n  }\n}\n\n.container-split__content-top {\n  //margin-bottom: em(60);\n  @include mq('desktop') {\n    //margin-bottom: em(100);\n  }\n}\n\n.container-split__sidebar {\n  @include mq('desktop') {\n    width: calc(630/1860 * 100%);\n  }\n  &--news {\n    display: none;\n    @include mq('desktop') {\n      display: block;\n    }\n  }\n}\n\n.container-split__bottom-tags {\n  padding: em(40) 0 em(60) 0;\n  border-top: 1px solid var(--color-GRAY_LINE);\n  border-bottom: 1px solid var(--color-GRAY_LINE);\n  @include mq('desktop') {\n    position: relative;\n    padding: em(60) 0 em(60) 0;\n  }\n}\n\n.container-split__bottom-soc {\n  margin-top: em(40);\n  @include mq('desktop') {\n    position: relative;\n    margin-top: em(60);\n  }\n}\n\n.container-split__text {\n  display: block;\n  padding-bottom: em(40);\n  @include mq('desktop') {\n    position: absolute;\n    top: 0;\n    left: -24.1%;\n    .container-split__bottom-tags & {\n      top: em(60);\n    }\n  }\n}\n</style>","<script setup>\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: []\n  },\n})\n\nconst { locale } = useI18n()\n\nconst fio = computed(() => props.sectionData?.config?.[`fio_${locale.value}`] ?? '')\nconst position = computed(() => props.sectionData?.config?.[`position_${locale.value}`] ?? '')\nconst text = computed(() => props.sectionData?.config?.[`text_${locale.value}`] ?? '')\nconst img = computed(() => props.sectionData?.config?.img ?? null)\n</script>\n\n<template>\n  <div class=\"article-quote\" v-if=\"fio || position || text\">\n    <div class=\"article-quote__text\" v-html=\"text\"></div>\n    <div class=\"article-quote__autor-space\" v-if=\"fio || position\"></div>\n    <div class=\"article-quote__autor\" v-if=\"fio || position\">\n      <div class=\"article-quote__autor-img\" v-if=\"img\">\n        <img :src=\"`/${img}`\" alt=\"image\">\n      </div>\n      <div class=\"article-quote__autor-label\">\n        <Text\n          :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n        >{{ sectionData?.config?.fio_ru }}</Text>\n        <Text\n          :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n        >{{ sectionData?.config?.position_ru }}</Text>\n      </div>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\">\n.article-quote {\n  display: block;\n  margin-top: em(60);\n  padding: em(30) 0 0;\n  border-bottom: 0;\n  padding-bottom: 0;\n  @include mq('desktop') {\n    display: flex;\n    margin-top: em(100);\n    padding: em(60) 0;\n    border-bottom: 1px solid var(--color-C_285);\n    border-top: 1px solid var(--color-C_285);\n    position: relative;\n  }\n  & + .article-quote {\n    margin-top: em(0);\n    border-top: 0;\n  }\n}\n\n.article-quote__text {\n  p {\n    margin-bottom: em(16);\n    font-size: em(27);\n    line-height: 100%;\n    @include mq('desktop') {\n      font-size: em(50);\n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  h2 {\n    margin-bottom: em(8);\n    font-size: em(50);\n    line-height: 90%;\n    @include mq('desktop') {\n      font-size: em(100);\n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  h3 {\n    margin-bottom: em(13.4);\n    font-size: em(40);\n    line-height: 100%;\n    @include mq('desktop') {\n      font-size: em(60);\n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  ol, ul {\n    padding-left: em(70);\n    margin-bottom: em(50);\n    li {\n      padding-left: 0;\n      font-size: em(27);\n      line-height: 100%;\n      @include mq('desktop') {\n        font-size: em(50);\n      }\n    }\n  }\n  p + ul, p + ol {\n    margin-top: em(-15);\n    @include mq('desktop') {\n      margin-top: em(-50);\n    }\n  }\n  s {\n    text-decoration: line-through;\n  }\n  sub {\n    font-size: em(8);\n    position: relative;\n    bottom: -3px;\n  }\n  sup {\n    font-size: em(8);\n    position: relative;\n    top: -3px;\n  }\n  .ql-align-center {\n    text-align: center;\n  }\n  .ql-align-right {\n    text-align: right;\n  }\n  .ql-align-justify {\n    text-align: justify;\n  }\n  br {\n    display: none;\n  }\n}\n\n.article-quote__autor-img {\n  background-color: #c4c4c4;\n  border-radius: 50%;\n  width: em(104);\n  height: em(104);\n  margin-bottom: em(20);\n  overflow: hidden;\n  @include mq('desktop') {\n    width: em(127);\n    height: em(127);\n    margin-bottom: em(45);\n  }\n  img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain;\n    object-position: center;\n  }\n}\n\n.article-quote__autor {\n  left: 0;\n  position: static;\n  border-top: 1px solid var(--color-GRAY);\n  padding-top: em(30);\n  margin-top: em(30);\n  max-width: none;\n  width: 100%;\n  font-family: var(--font-ttsmalls-medium);\n  @include mq('desktop') {\n    max-width: em(340);\n    position: absolute;\n    left: em(-630);\n    top: 0;\n  }\n  span {\n    display: block;\n    color:  var(--color-GRAY);\n  }\n}\n\n.article-quote__autor-space {\n  display: none;\n  @include mq('desktop') {\n    display: block;\n    height: em(220);\n  }\n}\n\n</style>","<script setup>\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: null,\n  },\n})\nconst { locale } = useI18n();\n\nconst text = computed(() => {\n  const config = props.sectionData?.config\n  const currentLocale = locale.value\n\n  if (config && currentLocale) {\n    return config[`text_${currentLocale}`] ?? ''\n  }\n  \n  return ''\n})\n\n</script>\n\n<template>\n  <div class=\"article-text\">\n    <div  \n      class=\"article-text__content\"\n      v-html=\"text\"\n    />\n  </div>\n</template>\n\n<style lang=\"scss\">\n.article-text {\n  margin-top: em(60);\n  @include mq('desktop') {\n    margin-top: em(100);\n  }\n}\n\n.article-text__content, .page-career__intro-bottom {\n  font-family: var(--font-ttsmalls-regular);\n  font-weight: 400;\n  p {\n    margin-bottom: em(25);\n    font-size: em(24);\n    line-height: 110%;\n    @include mq('desktop') {\n      font-size: em(36); \n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  h2 {\n    margin-bottom: em(8);\n    font-size: em(36); \n    line-height: 90%;\n    @include mq('desktop') {\n      font-size: em(100);\n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  h3 {\n    margin-bottom: em(13.4);\n    font-size: em(40);\n    line-height: 100%;\n    @include mq('desktop') {\n      font-size: em(60);\n    }\n    &:last-child {\n      margin-bottom: 0;\n    }\n  }\n  ol, ul {\n    padding-left: em(25);\n    margin-bottom: em(50);\n    li {\n      padding-left: 0;\n      font-size: em(24);\n      line-height: 110%;\n      @include mq('desktop') {\n        font-size: em(36);\n      }\n    }\n  }\n  p + ul, p + ol {\n    margin-top: em(-35);\n    @include mq('desktop') {\n      margin-top: em(-50);\n    }\n  }\n  ul, ol{\n    margin-left: em(30);\n  }\n  s {\n    text-decoration: line-through;\n  }\n  sub {\n    font-size: em(8);\n    position: relative;\n    bottom: -3px;\n  }\n  sup {\n    font-size: em(8);\n    position: relative;\n    top: -3px;\n  }\n  .ql-align-center {\n    text-align: center;\n  }\n  .ql-align-right {\n    text-align: right;\n  }\n  .ql-align-justify {\n    text-align: justify;\n  }\n  iframe {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 9;\n  }\n  li[data-list=\"bullet\"] {\n    list-style-type: disc;\n  }\n  br {\n    display: none;\n  }\n}\n</style>","<script setup>\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: null,\n  },\n})\n\nconst { locale } = useI18n()\n\nconst image = computed(() => {\n  if (props.sectionData && props.sectionData.config && props.sectionData.config.img) {\n    return props.sectionData.config?.img;\n  }\n})\n\nconst previewText = computed(() => {\n  if (\n    props.sectionData &&\n    props.sectionData.config &&\n    props.sectionData.config[\"preview_text_\" + locale.value]\n  ) {\n    return props.sectionData.config[\"preview_text_\" + locale.value];\n  }\n})\n</script>\n\n<template>\n  <div class=\"article-image\">\n    <img class=\"article-image__picture\" :src=\"process.env.API_URL + Image\" :alt=\"PreviewText\"/>\n    <div class=\"article-image__text\" v-if=\"previewText\">\n      <Text\n        :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n        :color=\"$color.GRAY\"\n      >{{ previewText }}</Text>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\">\n.article-image {\n  margin-top: em(60);\n  @include mq('desktop') {\n    margin-top: em(100);\n  }\n}\n\n.article-image__picture {\n  width: 100%;\n  height: auto;\n}\n\n.article-image__text {\n  margin-top: em(40);\n  max-width: em(730);\n}\n</style>","<script setup>\nimport { Swiper, SwiperSlide } from 'swiper/vue'\nimport { Autoplay } from 'swiper/modules'\n\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: null,\n  }\n})\n\nconst modules = [Autoplay]\nconst swiperInstance = ref(null)\n\n// Реактивный индекс активного слайда\nconst activeIndex = ref(0)\n\n// Общее количество слайдов — считаем из данных\nconst countAll = computed(() => {\n  return props.sectionData?.config?.slider?.slides?.length || 0\n})\n\nconst onSwiperInit = (swiper) => {\n  swiperInstance.value = swiper\n  // Инициализируем индекс при старте\n  activeIndex.value = swiper.realIndex\n}\n\n// Обновляем индекс при смене слайда\nconst onSlideChange = (swiper) => {\n  activeIndex.value = swiper.realIndex\n}\n\n// Переход к предыдущему слайду\nconst goPrev = () => {\n  if (!swiperInstance.value) return\n  swiperInstance.value.slidePrev()\n}\n\n// Переход к следующему слайду\nconst goNext = () => {\n  if (!swiperInstance.value) return\n  swiperInstance.value.slideNext()\n}\n\ndefineExpose({\n  getSwiper: () => swiperInstance.value\n})\n\n</script>\n\n<template>\n  <ClientOnly>\n    <Swiper\n      :modules=\"modules\"\n      :slides-per-view=\"1\"\n      :autoplay=\"false\"\n      :loop=\"true\"\n      @swiper=\"onSwiperInit\"\n      @slideChange=\"onSlideChange\"\n      class=\"article-slider\"\n    >     \n      <SwiperSlide v-for=\"(slide, idx) in sectionData?.config?.slider?.slides\" :key=\"slide.id || idx\">\n        <div class=\"article-slider__content\">\n          <picture>\n            <source :srcset=\"slide?.imageWebp\" type=\"image/webp\">\n            <img :src=\"slide?.image\" :alt=\"slide?.preview_image\" class=\"article-slider__img\" width=\"100%\" height=\"100%\">\n          </picture>\n        </div>\n      </SwiperSlide>\n    </Swiper>\n    <div class=\"article-slider__pagination\" role=\"tablist\">\n      <PaginationNumber\n        :numbCurrent=\"activeIndex + 1\"\n        :numbAll=\"countAll\"\n        :prev=\"goPrev\"\n        :next=\"goNext\"\n      />\n    </div>\n  </ClientOnly>\n</template>\n\n<style lang=\"scss\">\n.article-slider__content {\n  height: em(770);\n  position: relative;\n}\n\n.article-slider__img {\n  display: block;\n  height: 100%;\n  width: 100%;\n  object-fit: cover;\n  position: absolute;\n  left: 0;\n  right: 0;\n  top: 0;\n}\n\n.article-slider__pagination {\n  margin-top: em(60);\n}\n\n</style>","<script setup>\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: null,\n  },\n})\n</script>\n\n<template>\n  <div class=\"slider\">\n    <p>Видео</p>\n  </div>\n</template>\n\n<style lang=\"scss\">\n\n</style>","<script setup>\nconst props = defineProps({\n  sectionData: {\n    type: Object,\n    default: null\n  },\n})\n\nconst videoRutube = computed(() => {\n  if (props.sectionData && props.sectionData.config && props.sectionData.config.embed) {\n    return props.sectionData.config.embed;\n  }\n})\n\nconst previewText = computed(() => {\n  if (props.sectionData && props.sectionData.config && props.sectionData.config.caption) {\n    return props.sectionData.config.caption;\n  }\n})\n</script>\n\n<template>\n  <div class=\"article-rutube\">\n    <iframe  \n      :src=\"videoRutube\"\n      class=\"article-rutube__video\"\n      frameBorder=\"0\" allow=\"clipboard-write; autoplay\" \n      webkitAllowFullScreen \n      mozallowfullscreen \n      allowFullScreen\n    ></iframe>  \n    <div class=\"article-rutube__text\" v-if=\"PreviewText\">\n      <Text\n        :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n        :color=\"$color.GRAY\"\n      >{{ previewText }}</Text>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .article-rutube {\n    margin-top: em(60);\n    @include mq('desktop') {\n      margin-top: em(100);\n    }\n  }\n\n  .article-rutube__video {\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 9;\n  }\n\n  .article-rutube__text {\n    margin-top: em(40);\n    max-width: em(730);\n  }\n</style>\n","\nimport ArticleQuote from '~/components/elements/ArticleQuote.vue'\nimport ArticleText from '~/components/elements/ArticleText.vue'\nimport ArticleImage from '~/components/elements/ArticleImage.vue'\nimport ArticleSlider from '~/components/elements/ArticleSlider.vue'\nimport ArticleVideo from '~/components/elements/ArticleVideo.vue'\nimport ArticleRutube from '~/components/elements/ArticleRutube.vue'\n\nconst ARTICLE_COMPONENTS = {\n  quote: ArticleQuote,\n  text: ArticleText,\n  image: ArticleImage,\n  slider: ArticleSlider,\n  video: ArticleVideo,\n  rutube: ArticleRutube\n}\n\nexport const useArticleComponent = () => {\n  const getArticleComponent = (sectionType) => {\n    return ARTICLE_COMPONENTS[sectionType] ?? null\n  }\n\n  return { getArticleComponent }\n}"],"version":3}