QAAY;AAAA;;QACjE,MAAK;AAAA,QAAQ,QAAQA,MAAA,YAAA,KAAY;AAAA,QAAa,qBAAO,aAAA,QAAY;AAAA;;oBAI5BA,MAAA,QAAA,GAAQ,CAAzB,OAAOC,WAAK;;;UAC/B,MAAM;AAAA,UAAQ,MAAMA;AAAA;;;;;QAIrB,MAAK;AAAA,QAAgB,SAAK,YAAED,MAAA,SAAA,GAAW,cAAa;AAAA;;;QAI7D,MAAME,KAAAA,GAAE,eAAA;AAAA,QACR,MAAI,IAAMC,KAAAA,MAAM,MAAM;AAAA;;;;;;;;;;;;;;","names":["$typographyVariant","$font","$color","_push","_parent","_withAsyncContext","_unref","index","$t","$i18n"],"sources":["../../../../../../../app/components/elements/FilterItem.vue","../../../../../../../app/pages/media/index.vue"],"sourcesContent":["<script setup>\nconst props = defineProps({\n  name: String,\n  active: true\n});\n</script>\n\n<template>\n  <div class=\"filter\" :class=\"{'filter--active': active}\">\n    <Text\n      class=\"filter__text\"\n      :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n      :font=\"$font.TTSMALLS_REGULAR\"\n      :color=\"$color.GRAY\"\n    >{{ name }}</Text>\n    <Text\n      class=\"filter__plus\"\n      :variant=\"[$typographyVariant.T_NORMAL_18_MOB, $typographyVariant.T_NORMAL_24]\"\n      :font=\"$font.TTSMALLS_REGULAR\"\n      :color=\"$color.GRAY\"\n    > + </Text>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.filter  {\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: em(6);\n  &--active {\n    .filter__text {\n      border-bottom: 1px solid var(--color-C_2101);\n    }\n  }\n}\n\n.filter__plus, .filter__text {\n  padding-bottom: 10px;\n}\n\n.filter__text {\n  border-bottom: 1px solid transparent;\n  &:hover {\n    border-bottom:  1px solid var(--color-C_2101);\n  }\n}\n</style>","<script setup>\nconst { locale } = useI18n()\nconst route = useRoute()\nconst router = useRouter()\nconst newsStore = useNewsStore()\n// Загрузка данных для первых 6 новостей\nconst { newsList } = storeToRefs(newsStore)\nawait useAsyncData('initialNewsMedia', () => newsStore.fetchInitialNews())\n// Загрузка фильтров\nconst { newsListFilter } = storeToRefs(newsStore)\nawait useAsyncData('newsFilters', () => newsStore.fetchNewsFilters())\n\nconst isOpen = ref(false)\nconst activeFilter = ref(null)\n\n// Открываем модалку при выборе любого фильтра, кроме \"Все\"\nwatch(activeFilter, (value) => {\n  isOpen.value = value !== null\n})\n\n// Источником истины выбранных фильтров служит URL query\nconst FILTER_GROUPS = ['assets', 'tags', 'years', 'months']\n\nfunction filtersFromQuery(query) {\n  const result = {}\n  for (const group of FILTER_GROUPS) {\n    const raw = query[group]\n    if (typeof raw === 'string' && raw.length > 0) {\n      result[group] = raw.split(',').filter(Boolean)\n    }\n  }\n  return result\n}\n\nconst appliedFilters = ref(filtersFromQuery(route.query))\n\n// Синхронизируем стор и список при изменении query (в т.ч. назад/вперёд, прямая ссылка)\nwatch(\n  () => route.query,\n  async (query) => {\n    const next = filtersFromQuery(query)\n    const changed = JSON.stringify(next) !== JSON.stringify(appliedFilters.value)\n    appliedFilters.value = next\n    if (changed) {\n      await newsStore.applyFilters(next)\n    }\n  }\n)\n\n// Применение фильтров из модалки → обновляем URL (watch выше перезапросит данные)\nasync function onApplyFilters(draft) {\n  const query = { ...route.query }\n  for (const group of FILTER_GROUPS) {\n    const ids = draft[group]\n    if (ids && ids.length > 0) {\n      query[group] = ids.join(',')\n    } else {\n      delete query[group]\n    }\n  }\n  await router.push({ query })\n}\n\nuseHead({\n  bodyAttrs: {\n    style: computed(() => isOpen.value ? 'overflow: hidden' : '')\n  }\n})\n</script>\n\n<template>\n<div>\n  <div class=\"news-header\">\n    <Text\n      tag=\"h1\"\n      :variant=\"[$typographyVariant.T_H1_55_MOB, $typographyVariant.T_H1_150]\"\n      :font=\"$font.MAREGRAPHE_REGULAR\"\n      :color=\"$color.WHITE\"\n    >Новости</Text>\n  </div>\n\n  <div class=\"news-filter\">\n    <FilterItem name=\"Все\" :active=\"activeFilter == null\" />\n    <FilterItem name=\"Активы\" :active=\"activeFilter == 'assets'\" @click=\"activeFilter = 'assets'\" />\n    <FilterItem name=\"Теги\" :active=\"activeFilter == 'tags'\" @click=\"activeFilter = 'tags'\" />\n    <FilterItem name=\"Дата\" :active=\"activeFilter == 'date'\" @click=\"activeFilter = 'date'\" />\n  </div>\n\n  <div class=\"news\">\n    <div class=\"news__item\" v-for=\"(items, index) in newsList\" :key=\"items.id\">\n      <NewsCard :news=\"items\" :numb=\"index\"/>\n    </div>\n  </div>\n  <div class=\"news-button container-full\">\n    <ButtonMore text=\"Показать ещё\" @click=\"newsStore?.fetchMoreNews()\"/>\n  </div>\n  <div class=\"news-next container-full\">\n    <PaginationPage \n      :text=\"$t('contacts.name')\"\n      :link=\"`/${$i18n.locale}/contacts`\"\n    />\n  </div>\n</div>\n  <ClientOnly>\n    <FilterModal \n      v-model:show=\"isOpen\"\n      v-model:active=\"activeFilter\"\n      :modalTitle=\"newsListFilter\"\n      :appliedFilters=\"appliedFilters\"\n      @apply=\"onApplyFilters\"\n    />\n  </ClientOnly>\n</template>\n\n<style lang=\"scss\" scoped>\n.news-header {\n  display: block;\n  margin: em(57) 0 em(100);\n  @include mq('desktop') {\n    margin: em(88) 0 em(125);\n  }\n}\n\n.news-filter {\n  display: flex;\n  align-items: center;\n  gap: em(15);\n  margin-bottom: em(20);\n  @include mq('desktop') {\n    gap: em(30);\n    margin-bottom: em(55);\n  }\n}\n\n.news {\n  width: 100%;\n  display: flex;\n  flex-wrap: wrap;\n  gap: em(20) 0;\n  @include mq('desktop') {\n    gap: em(30);\n  }\n}\n\n.news__item {\n  position: relative;\n  width: 100%;\n  &::after {\n    content: \"\";\n    width: 100%;\n    height: 1px;\n    background-color: var(--color-GRAY_LINE);\n    position: absolute;\n    left: 0;\n    bottom: 0;\n  }\n  @include mq('desktop') {\n    width: calc((100% - em(60)) / 3);\n    &::after {\n      width: calc(100% + em(30));\n      left: em(-15);\n    }\n  }\n}\n\n.news-button {\n  display: flex;\n  justify-content: center;\n  padding: em(80) 0;\n  position: relative;\n  @include mq('desktop') {\n  padding: em(100) 0;\n    &::after {\n      content: \"\";\n      width: 100%;\n      height: 1px;\n      background-color: var(--color-GRAY_LINE);\n      position: absolute;\n      bottom: -1px;\n      left: 0;\n    }\n  }\n}\n</style>"],"version":3}