ton-pervious {\n  display: flex;\n  gap: em(10);\n  align-items: center;\n}\n</style>","<script setup>\nconst props = defineProps({\n  news: String,\n  textPrev: String,\n  textNext: String,\n  logoPrev: String,\n  logoNext: String,\n  linkPrev: String,\n  linkNext: String\n})\n</script>\n\n<template> \n  <div class=\"split-nav container-full\">\n    <div class=\"split-nav__block\">\n      <NuxtLinkLocale\n        class=\"split-nav__item split-nav__item--left\" \n        :to=\"linkPrev\"\n        @click=\"console.log('вверх')\"  \n      >\n        <Text\n          :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SMALL_20]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          :color=\"$color.WHITE\"\n        >{{textPrev}}</Text>\n        <span class=\"split-nav__logo\" v-if=\"logoPrev\">\n          <img :src=\"logoPrev\" alt=\"\">\n        </span>\n        <IconSvg\n          :name=\"$iconName.ARROW_LEFT\" \n          :size=\"[$iconSize.NEW_MEDIUM_MOB, $iconSize.NEW_MEDIUM_MOB]\"\n          :color=\"$color.WHITE\"\n          class=\"split-nav__arrow split-nav__arrow--left\"\n          v-if=\"news\"\n        />\n      </NuxtLinkLocale>\n      <NuxtLinkLocale  \n        class=\"split-nav__item split-nav__item--right\"\n        :to=\"linkNext\"\n        @click=\"console.log('вверх')\"  \n      >\n        <Text\n          :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SMALL_20]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          :color=\"$color.WHITE\"\n        >{{textNext}}</Text>\n        <span class=\"split-nav__logo\" v-if=\"logoNext\">\n          <img :src=\"logoNext\" alt=\"\">\n        </span>\n        <IconSvg\n          :name=\"$iconName.ARROW_RIGHT\" \n          :size=\"[$iconSize.LARGE, $iconSize.NEW_MEDIUM_MOB]\"\n          :color=\"$color.WHITE\"\n          class=\"split-nav__arrow split-nav__arrow--right\"\n          v-if=\"news\"\n        />\n      </NuxtLinkLocale>\n    </div>\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.split-nav__block {\n  display: flex;\n  justify-content: space-between;\n  height: 300px;\n  flex-wrap: wrap;\n  overflow: hidden;\n  @include mq('desktop') {\n    height: 20.8vw;\n  }\n  .split-nav__item {\n    width: 50%;\n    height: 100%; \n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    padding: em(20) em($offset-base-mob) em(20) em($offset-base-mob);\n    position: relative;\n    span {\n      max-width: 100px;\n      @include mq('desktop') {\n        max-width: none;\n      }\n    }\n    @include mq('desktop') {\n      padding: em(30) em($offset-base-desc) em(30) em($offset-base-desc);\n      max-width: auto;\n    }\n    &--left {\n      background-color: var(--color-C_285);\n      .split-nav__logo {\n        left: 0;\n        @include mq('desktop') {\n          left: em(-20);\n        }\n      }\n    }\n    &--right {\n      background-color: var(--color-C_2726);\n      .split-nav__logo{\n        right: 0;\n        @include mq('desktop') {\n          right: em(-20);\n        }\n      }\n      span {\n        text-align: right;\n        margin-left: auto;\n      }\n    }\n    &:hover {\n      .split-nav__logo img {\n        @include mq('desktop') {\n          width: 18vw;\n        }\n      }\n    }\n  }\n\n  .split-nav__logo {\n    position: absolute;\n    bottom: -20px;\n    @include mq('desktop') {\n      bottom: em(-30);\n    }\n  }\n\n  .split-nav__logo img {\n    display: block;\n    transition: width .4s;\n    width: 140px;\n    @include mq('desktop') {\n      width: 16vw;\n    }\n  }\n  .split-nav__arrow {\n    text-align: right;\n    @include mq('desktop') {\n      display: none;\n    }\n    &--right {\n      margin-left: auto;\n    }\n  }\n}\n</style>"],"version":3}