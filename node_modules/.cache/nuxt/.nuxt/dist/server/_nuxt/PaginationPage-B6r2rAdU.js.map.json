{"file":"PaginationPage-B6r2rAdU.js","mappings":";;;;;;;;;;;;;;AACiB,cAAA;;;;;QADIA,gBAAAA,KAAAA,OAAO;AAAA,MAAA;;QAiBxB,OAAM;AAAA,QACL,MAAM,QAAA;AAAA,MAAA;;QAIJ,UAAUC,KAAAA,mBAAmB,aAAaA,KAAAA,mBAAmB,QAAQ;AAAA,MAAA;yBADxE,CAEkB,GAAAC,QAAAC,UAAA,aAAA;;qCAAd,QAAA,IAAI,CAAA,EAAA;AAAA;;8CAAJ,QAAA,IAAI,GAAA,CAAA;AAAA,YAAA;AAAA;;;;;QAEN,OAAM;AAAA,QACL,MAAMC,KAAAA,UAAU;AAAA,QAChB,OAAOC,KAAAA,UAAU,gBAAgBA,KAAAA,UAAU,KAAK;AAAA,QAChD,OAAOL,KAAAA,OAAO;AAAA,MAAA;;;;;;;;;;;;","names":["$color","$typographyVariant","_push","_parent","$iconName","$iconSize"],"sources":["../../../../../../../app/components/elements/PaginationPage.vue"],"sourcesContent":["<script setup>\n  const router = useRouter()\n\n  const props = defineProps({\n    text: String,\n    link: String,\n  });\n\n  const goLink = (link) => { \n    const isCheckHttps = /(http(s?)):\\/\\//i.test(link);\n    if (isCheckHttps) { window.open(link,'_blank') } \n    else { router.push(link) }\n  }\n</script>\n\n<template>\n  <a\n    class=\"page-pagination\" \n    :href=\"link\"\n    @click.prevent=\"goLink(link)\"\n  >\n    <Text\n      :variant=\"[$typographyVariant.T_H1_55_MOB, $typographyVariant.T_H1_150]\"\n    > {{text}} </Text>\n    <IconSvg\n      class=\"page-pagination__arrow\"\n      :name=\"$iconName.ARROW_UP\"\n      :size=\"[$iconSize.NEW_MEDIUM_MOB, $iconSize.LARGE]\"\n      :color=\"$color.WHITE\"\n    />\n  </a>\n</template>\n\n<style lang=\"scss\" scoped>\n.page-pagination {\n  z-index: 1;\n  width: 50%;\n  margin-left: auto;\n  height: em(500);\n  background-color: v-bind(\"$color.C_2726\");\n  position: relative;\n  display: flex;\n  flex-direction: row;\n  align-items: flex-end;\n  padding: 0 0 em(40) em(30);\n  font-family: 'MaregrapheRegular', Arial, sans-serif;\n  font-weight: 500;\n  &:hover {\n    cursor: pointer;\n    .page-pagination__arrow {\n      transform: translateX(0);\n      opacity: 1;\n      transition: transform .7s, opacity .6s;\n      @media screen and (max-width: 1050px) {\n        transform: translateX(0) rotate(45deg);\n      }\n    }\n  }\n  @media screen and (max-width: 1050px) {\n    width: 100%;\n    height: em(300);\n    padding: 0 0 em(30) em(10);\n  }\n}\n.page-pagination__arrow {\n  position: absolute;\n  right: em(30);\n  bottom: em(60);\n  transform: translateX(-40px);\n  opacity: 0;\n  z-index: 1;\n  @media screen and (max-width: 1050px) {\n    transform: translateX(0) rotate(45deg);\n    opacity: 1;\n    right: em(20);\n    bottom: em(30);\n  }\n}\n</style>"],"version":3}