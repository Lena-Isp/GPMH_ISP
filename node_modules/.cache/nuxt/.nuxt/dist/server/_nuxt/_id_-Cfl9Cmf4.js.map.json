A;+BAHjB,CAIiCX,IAAAJ,QAAAC,UAAAI,cAAA;;AAA9B,kBAAAL,OAAA,GAAAM,eAAAT,MAAA,eAAA,GAAiB,IAAI,CAAA,EAAA;AAAA;;oBAArBU,gBAAAC,gBAAAX,MAAA,eAAA,GAAiB,IAAI,GAAA,CAAA;AAAA;;;;;;;cAGrB,SAASA,MAAA,eAAA,GAAiB;AAAA,cAC1B,OAAOkB,KAAAA,OAAO;AAAA,cACf,MAAK;AAAA;;;cATPL,YAIiC,iBAAA;AAAA,gBAH9B,UAAUR,KAAAA,mBAAmB,gBAAgBA,KAAAA,mBAAmB,UAAU;AAAA,gBAC1E,MAAMC,KAAAA,MAAM;AAAA,gBACZ,OAAOY,KAAAA,OAAO;AAAA;iCAChB,MAAyB;AAAA,kBAAvBR,gBAAAC,gBAAAX,MAAA,eAAA,GAAiB,IAAI,GAAA,CAAA;AAAA;;;cACxBa,YAAM,IAAA;AAAA,cAAAA,YAAM,IAAA;AAAA,cACZA,YAIE,uBAAA;AAAA,gBAHC,SAASb,MAAA,eAAA,GAAiB;AAAA,gBAC1B,OAAOkB,KAAAA,OAAO;AAAA,gBACf,MAAK;AAAA;;;;;;;;QAMN,UAAUb,KAAAA,mBAAmB,aAAaA,KAAAA,mBAAmB,QAAQ;AAAA,QACrE,MAAMC,KAAAA,MAAM;AAAA;yBAFf,CAGe,GAAAH,QAAAC,UAAA,aAAA;;;;;8BAAd,SAAO;AAAA;;;;;;QAEN,MAAK;AAAA,QACJ,MAAI,eAAiBJ,MAAA,eAAA,GAAiB,IAAI;AAAA;;oBAI9BA,MAAA,eAAA,GAAiB,WAAS,CAAlC,SAAI;;UACV,KAAK,KAAK;AAAA,UACV,MAAM,KAAK;AAAA,UACX,MAAM,KAAK;AAAA,UACX,MAAM,KAAK;AAAA;;;;QAIX,UAAQ,GAAKA,MAAA,eAAA,GAAiB,OAAO,QAAQ;AAAA,QAC7C,UAAQ,GAAKA,MAAA,eAAA,GAAiB,OAAO,IAAI;AAAA,QACzC,UAAUA,MAAA,eAAA,GAAiB;AAAA,QAC3B,UAAUA,MAAA,eAAA,GAAiB;AAAA,QAC3B,UAAQ,qBAAuBA,MAAA,eAAA,GAAiB,OAAO,QAAQ;AAAA,QAC/D,UAAQ,qBAAuBA,MAAA,eAAA,GAAiB,OAAO,IAAI;AAAA;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","_unref","$t","_ssrRenderComponent","_push","_parent","$typographyVariant","$font","_","_scopeId","_ssrInterpolate","_createTextVNode","_toDisplayString","_ssrRenderList","_createVNode","_openBlock","_createBlock","_Fragment","_resolveDynamicComponent","$color"],"sources":["../../../../../../../app/pages/business/partner/[id].vue"],"sourcesContent":["<script setup>\ndefinePageMeta({\n  theme: 'light' \n})\n\nconst route = useRoute();\nconst { locale } = useI18n()\nconst localePath = useLocalePath()\n\n//composables\nconst { getArticleComponent } = useArticleComponent()\n\n// Загрузка данных для страницы\nconst partnerStore = usePartnerStore()\nconst { currentPartners } = storeToRefs(partnerStore)\nconst { data: result, error } = await useAsyncData(\n  `prtners-${route.params.id}-${locale.value}`, \n  () => partnerStore.fetchPartnersBySlug(route.params.id)\n)\n\n//редирект для страницы, где нет английской версии\nif (result.value?.isRedirect) {\n  await navigateTo(localePath('/business'), {\n    redirectCode: 308,\n    replace: true\n  })\n}\n\n//редирект для несуществующей новости\nif (error.value) {\n throw error\n}\n</script>\n\n<template>\n<div class=\"business-page\">\n  <div class=\"business-page__preview-bg container-full\">\n    <!--видео-->\n    <video \n      autoplay muted loop playsinline=\"\"\n      class=\"business-page__video\"\n      v-if=\"currentPartners?.video\"\n    >\n      <source\n        :src=\"currentPartners?.video\"\n        type=\"video/mp4\"\n      >\n      <source\n        :src=\"currentPartners?.video\"\n        type=\"video/webm\"\n      >\n    </video>\n    <!--END видео-->\n    <!--изображение-->\n    <img \n      v-if=\"currentPartners?.image\"\n      class=\"business-page__image\"\n      :src=\"currentPartners?.image\" \n      alt=\"\"\n    >\n    <!--END изображение-->\n    <ButtonPervious class=\"business-page__button\"\n      link=\"/business\"\n      :text=\"$t('partnerId.back')\"\n    />\n    <img class=\"business-page__logo\" \n      :src=\"currentPartners?.logo\" \n      :alt=\"currentPartners?.logo_alt\"\n    >\n  </div>\n  <ContainerSplit :visible-bottom=\"false\">\n    <template #content>\n      <Text \n        :variant=\"[$typographyVariant.T_SUPER_BIG_27_MOB, $typographyVariant.T_SUPER_BIG_50]\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n      >{{currentPartners?.text}}</Text>\n      <!--основные блоки из админки-->\n      <component\n        v-for=\"(section, idx) in currentPartners?.sections\"\n        :key=\"idx\"\n        :is=\"getArticleComponent(section.type)\"\n        :section-data=\"section\"\n      />\n    </template>\n    <template #sidebar>\n      <Text \n        :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SMALL_20]\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n        :color=\"$color.GRAY\"\n      >{{currentPartners?.link}}</Text>\n      <br /><br />\n      <SocialList\n        :socials=\"currentPartners?.socials\"\n        :color=\"$color.GRAY\"\n        mode=\"link\"\n      />\n    </template>\n  </ContainerSplit>\n  <div>\n    <Text \n      :variant=\"[$typographyVariant.T_H2_50_MOB, $typographyVariant.T_H2_100]\"\n      :font=\"$font.MAREGRAPHE_REGULAR\"\n    >Новости</Text>\n    <Links\n      link=\"/business\"\n      :text=\"`Все новости ${currentPartners?.name}`\"\n    />\n  </div>\n  <AssetsNews\n    v-for=\"item in currentPartners?.last_news\"\n    :key=\"item.id\"\n    :date=\"item.created_at\" \n    :text=\"item.name\"\n    :slug=\"item.slug\"\n  />\n  <br /><br />\n  <SplitNav\n    :textPrev=\"`${currentPartners?.links?.previous}`\" \n    :textNext=\"`${currentPartners?.links?.next}`\" \n    :logoPrev=\"currentPartners?.logo\" \n    :logoNext=\"currentPartners?.logo\"\n    :linkPrev=\"`/business/partner/${currentPartners?.links?.previous}`\"\n    :linkNext=\"`/business/partner/${currentPartners?.links?.next}`\"\n  />\n</div>\n</template>\n\n<style lang=\"scss\" scoped>\n  .business-page__preview-bg {\n    position: relative;\n    min-height: em(540);\n    @include mq('desktop') {\n      min-height: em(700);\n    }\n  }\n\n  .business-page__button {\n    position: relative;\n    z-index: 1;\n  }\n\n  .business-page__video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    position: absolute;\n    left: 0;\n    top: 0;\n    will-change: transform;\n    z-index: 0;\n  }\n\n  .business-page__image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    position: absolute;\n    left: 0;\n    top: 0;\n    will-change: transform;\n    z-index: 0;\n  }\n\n  .business-page__logo {\n    position: absolute;\n    left: 0;\n    bottom: em(-20);\n    width: em(170);\n    height: em(170);\n    z-index: 1;\n    @include mq('desktop') {\n      width: em(350);\n      height: em(350);\n      bottom: em(-50);\n    }\n  }\n</style>"],"version":3}