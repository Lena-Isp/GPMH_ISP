{"file":"SocialList-CAx_kh1v.js","mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;AACA,UAAM,QAAQ;AAuBd,UAAM,MAAM,cAAA;AAEZ,UAAM,aAAa,mBAAmB,IAAI,IAAI;AAS9C,UAAM,mBAAmB;AAAA,MACvB,YAAY;AAAA,QACV;AAAA,QACA,8BAA8B,UAAU;AAAA,MAAA;AAAA,MAE1C,aAAa;AAAA,QACX;AAAA,QACA,gCAAgC,UAAU;AAAA,MAAA;AAAA,MAE5C,iBAAiB;AAAA,QACf;AAAA,QACA,kIAAkI,UAAU;AAAA,MAAA;AAAA,MAE9I,UAAU,CAAC,WAAW;AAAA,MACtB,QAAQ,CAAC,SAAS;AAAA,MAClB,SAAS,CAAC,UAAU;AAAA,IAAA;AAGtB,UAAM,WAAW,SAAS,MAAM;AAC9B,UAAK,CAAC,MAAM,QAAS;AACrB,aAAO,MAAM,QAAQ,IAAI,CAAA,UAAS;AAAA,QAChC,GAAG;AAAA,QACH,MAAM,iBAAiB,MAAM,KAAK,IAAI,CAAC;AAAA,QACvC,OAAO,iBAAiB,MAAM,KAAK,IAAI,CAAC;AAAA,MAAA,EACxC;AAAA,IACJ,CAAC;;;UAIuE,QAAA,SAAO;;UAA1E,OAAK,CAAC,eAAsB,QAAA,UAAM,qBAAA;AAAA,QAAA;sBACCA,MAAA,QAAA,GAAQ,CAA5B,UAAU,UAAK;;AAEvB,cAAA,UAAU,MAAI;AACnB,kBAAA,KAAAC,cAAA,QAAM,QAAA,SAAI,UAAe,UAAU,IAAI,CAAA,6DAAA;;cAMtC,MAAK;AAAA,cACJ,MAAI,SAAW,UAAU,IAAI;AAAA,cAC7B,kBAAiB,QAAA,MAAA;AAAA,cAClB,OAAM;AAAA,cACN,OAAM;AAAA,cACL,QAAQ,QAAA,SAAM,QAAA;AAAA,YAAA;;;;;;;;;;;;;;;;;;;;;","names":["_unref","_ssrRenderAttr"],"sources":["../../../../../../../app/components/elements/SocialList.vue"],"sourcesContent":["<script setup>\nconst props = defineProps({\n  color: String,\n\n  socials: {\n    type: Array,\n    default: [\n      { title: 'Telegram' },\n      { title: 'ВКонтакте' },\n      { title: 'Одноклассники' },\n    ]\n  },\n\n  mode: {\n    type: String,\n    default: 'link' // \"share\" или \"link\" или \"footer\"\n  },\n\n  footer: {\n    type: Boolean,\n    default: false\n  }\n})\n\nconst url = useRequestURL(); //для определения ссылки в адресной строке\n\nconst encodedUrl = encodeURIComponent(url.href)\n\nconst share = (event, url) => {\n  if (props.mode === 'share') {\n    event.preventDefault();\n    window.open(url, '_blank', 'height=500,width=500,menubar=no,toolbar=no,location=no');\n  }\n};\n\nconst shareNetworksMap = {\n  'Telegram': [\n    'soctgm', \n    `https://t.me/share/url?url=${encodedUrl}`\n  ],\n  'ВКонтакте': [\n    'socvk', \n    `https://vk.com/share.php?url=${encodedUrl}`\n  ],\n  'Одноклассники': [\n    'socok', \n    `https://connect.ok.ru/dk?cmd=WidgetSharePreview&st.cmd=WidgetSharePreview&st._aid=ExternalShareWidget_SharePreview&st.shareUrl=${encodedUrl}`\n  ],\n  'RuTube': ['socrutube'],\n  'Дзен': ['socdzen'],\n  'Yappy': ['socyappy']\n};\n\nconst networks = computed(() => {\n  if  (!props.socials) return\n  return props.socials.map(item => ({\n    ...item,\n    icon: shareNetworksMap[item?.title]?.[0],\n    share: shareNetworksMap[item?.title]?.[1]\n  }))\n});\n</script>\n\n<template>\n<div class=\"sosial-icon\" :class=\"footer && 'sosial-icon--footer'\" v-if=\"socials\">\n  <template v-for=\"(iconItem, index) in networks\" :key=\"index\">\n    <a \n      v-if=\"iconItem?.icon\"\n      :href=\"mode === 'link' && iconItem?.link\"\n      rel=\"noopener noreferrer\"\n      target=\"_blank\"\n      @click=\"share($event, iconItem?.share)\"\n    >\n      <Icon\n        mode=\"svg\"\n        :name=\"`icons:${iconItem?.icon}`\"\n        :style=\"{'color': color}\"\n        class=\"sosial-icon__item\"\n        width=\"auto\"\n        :height=\"footer ? '2em' : '2.5em' \"\n      />\n    </a>\n  </template>\n</div>\n</template>\n\n<style lang=\"scss\" scoped>\n.sosial-icon {\n  display: flex;\n  align-items: center;\n  gap: em(16);\n  &--footer {\n    gap: em(10);\n    @include mq('desktop') {\n      gap: em(30);\n    }\n  }\n}\n</style>"],"version":3}