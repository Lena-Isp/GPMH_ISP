gBAAAF,MAAA,cAAA,GAAgB,aAAa,GAAA,CAAA;AAAA;;;eAGjCO,UAAA,IAAA,GAAAC,YAKEC,2BAJyBT,MAAA,cAAA,GAAgB,UAAQ,CAAzC,SAAS,QAAG;AADtB,uBAAAO,UAAA,GAAAC,YAKEE,wBAFKV,MAAA,mBAAA,EAAoB,QAAQ,IAAI,CAAA,GAAA;AAAA,kBADpC,KAAK;AAAA,kBAEL,gBAAc;AAAA;;;;;QAKR,iBAAX,CAKW,GAAAH,QAAAC,UAAA,aAAA;;;cAHN,OAAOL,KAAAA,OAAO;AAAA,cACf,MAAK;AAAA;;;cAFPa,YAGE,uBAAA;AAAA,gBAFC,OAAOb,KAAAA,OAAO;AAAA,gBACf,MAAK;AAAA;;;;;;;;QAMT,UAAS;AAAA,QACT,UAAS;AAAA,QACR,UAAQ,UAAYO,MAAA,cAAA,GAAgB,OAAO,QAAQ;AAAA,QACnD,UAAQ,UAAYA,MAAA,cAAA,GAAgB,OAAO,IAAI;AAAA;;;;;;;;;;;;","names":["_withAsyncContext","_ssrRenderAttrs","_mergeProps","$color","$t","$typographyVariant","$font","_push","_parent","_ssrInterpolate","_unref","_createTextVNode","_toDisplayString","_","_scopeId","_ssrRenderList","_createVNode","_openBlock","_createBlock","_Fragment","_resolveDynamicComponent"],"sources":["../../../../../../../app/pages/media/[id].vue"],"sourcesContent":["<script setup>\ndefinePageMeta({\n  theme: 'light'\n})\n\nconst route = useRoute();\nconst { locale } = useI18n()\nconst localePath = useLocalePath()\n\n//composables\nconst { getArticleComponent } = useArticleComponent()\n\n// Загрузка данных для страницы\nconst newsStore = useNewsStore()\nconst { currentArticle } = storeToRefs(newsStore)\nconst { data: result, error } = await useAsyncData(\n  `news-${route.params.id}-${locale.value}`, \n  () => newsStore.fetchNewsBySlug(route.params.id)\n)\n\n//редирект для страницы, где нет английской версии\nif (result.value?.isRedirect) {\n  await navigateTo(localePath('/media'), {\n    redirectCode: 308,\n    replace: true\n  })\n}\n\n//редирект для несуществующей новости\nif (error.value) {\n  await navigateTo(localePath('/media'), {\n    redirectCode: 301,\n    replace: true\n  })\n}\n</script>\n\n\n<template>\n<div class=\"news-page\">\n  <div class=\"news-page__button\">\n    <ButtonPervious\n      to=\"/media\"\n      :color=\"$color.BLACK\"\n      :text=\"$t('mediaId.back')\"\n    />\n  </div>\n  <div class=\"news-page__date\">\n    <Text\n      :variant=\"$typographyVariant.T_SMALL_20\"\n      :font=\"$font.MAREGRAPHE_REGULAR\"\n      :color=\"$color.GRAY\"\n    >{{ currentArticle?.date }}</Text>\n  </div>\n  <div class=\"news-page__header\">\n    <Text\n      tag=\"h3\"\n      :variant=\"$typographyVariant.T_H3_60\"\n      :font=\"$font.MAREGRAPHE_REGULAR\"\n    >{{ currentArticle?.name }}</Text>\n  </div>\n\n  <ContainerSplit>\n    <!--справа блок-->\n    <template #content>\n      <!--Картинка-->\n      <img :src=\"currentArticle?.preview_webp\" alt=\"\" class=\"img\">\n\n      <!--Превью текст-->\n      <Text\n        tag=\"span\"\n        :variant=\"$typographyVariant.T_BIG_36\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n      >{{ currentArticle?.preview_title }}</Text>\n\n      <!--основные блоки из админки-->\n      <component\n        v-for=\"(section, idx) in currentArticle?.sections\"\n        :key=\"idx\"\n        :is=\"getArticleComponent(section.type)\"\n        :section-data=\"section\" \n      />\n    </template>\n\n    <!--нижний блок-->\n    <template #sidebar>\n      <SocialList\n        :color=\"$color.GRAY\"\n        mode=\"share\"\n      />\n    </template>\n  </ContainerSplit>\n  <br /><br />\n  <SplitNav\n    textPrev=\"Предыдущая новость\" \n    textNext=\"Следующая новость\" \n    :linkPrev=\"`/media/${currentArticle?.links?.previous}`\"\n    :linkNext=\"`/media/${currentArticle?.links?.next}`\"\n  />\n</div>\n</template>\n\n<style lang=\"scss\" scoped>\n.news-page__button {\n  display: block;\n  padding: em(30) 0;\n  border-bottom: 1px solid var(--color-GRAY_LINE);\n  @include mq('desktop') {\n    padding: em(40) 0;\n  }\n}\n\n.news-page__date {\n  margin-top: em(30);\n  @include mq('desktop') {\n    margin-top: em(40);\n  }\n}\n\n.news-page__header {\n  margin-top: em(30);\n  @include mq('desktop') {\n    margin-top: em(40);\n  }\n}\n\n.img {\n  width: 100%;\n  max-width: auto;\n}\n</style>"],"version":3}