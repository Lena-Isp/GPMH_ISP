AA,UACb,MAAK;AAAA,UACL,OAAM;AAAA;2BALR,CAM+C,GAAAC,QAAAC,UAAA,aAAA;;uCAA3CN,MAAA,SAAA,GAAW,aAAa,SAAS,CAAA,EAAA;AAAA;;gDAAjCA,MAAA,SAAA,GAAW,aAAa,SAAS,GAAA,CAAA;AAAA;;;;;AAE7B,YAAAA,MAAA,SAAA,GAAW,gBAAc;;YAC9B,SAASA,MAAA,SAAA,GAAW;AAAA,YACpB,OAAOQ,KAAAA,OAAO;AAAA,YACf,MAAK;AAAA,YACL,QAAA;AAAA;;;;;;;;;;QAMA,KAAI;AAAA,QACH,UAAUL,KAAAA,mBAAmB,gBAAgBA,KAAAA,mBAAmB,gBAAgB;AAAA,QAChF,MAAMC,KAAAA,MAAM;AAAA,QACZ,MAAMJ,MAAA,MAAA,KAAM;QAIb,QAAO;AAAA,QACP,OAAM;AAAA;yBATR,CAU8C,GAAAK,QAAAC,UAAA,aAAA;;;;;8BAA7C,wCAAsC;AAAA;;;;;;QAEpC,UAAUH,KAAAA,mBAAmB,gBAAgBA,KAAAA,mBAAmB,gBAAgB;AAAA,QAChF,MAAMC,KAAAA,MAAM;AAAA,QACb,OAAM;AAAA;yBAHR,CAOO,GAAAC,QAAAC,UAAA,aAAA;;;;;cAFPQ,YAA6C,QAAA,EAAvC,OAAM,yBAAwB,GAAC,GAAC;AAAA,8BAAO,iDAE7C;AAAA;;;;;;;;;;;;;;;;;;;;;AClGR,UAAM,QAAQ,SAAQ;AACtB,UAAM,QAAQ,SAAS,MAAM,MAAM,KAAK,SAAS,MAAM;AAEvD,UAAM,eAAe,gBAAe;AACpC,IAAA,CAAA,QAAA,SAAA,IAAAI,iBAAA,MAAM,aAAa,cAAc,MAAM,aAAa,cAAa,CAAE,CAAA;AAEnE,UAAM,YAAY,aAAY;AAC9B,IAAA,CAAA,QAAA,SAAA,IAAAA,iBAAA,MAAM,aAAa,eAAe,MAAM,UAAU,cAAa,CAAE,CAAA;;;;;QAI3D,6BAA6BlB,MAAA,KAAA,CAAK,EAAA;AAAA;;;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderList","_ssrRenderAttr","$typographyVariant","$font","_push","_parent","$t","$color","_","_scopeId","_ssrInterpolate","_createTextVNode","_toDisplayString","_createVNode","$iconName","$iconSize","_ssrRenderComponent","_withAsyncContext"],"sources":["../../../../../../../app/components/elements/MenuOverlay.vue","../../../../../../../app/stores/menu.js","../../../../../../../app/components/widgets/MenuDesc.vue","../../../../../../../app/components/elements/MenuBurger.vue","../../../../../../../app/components/elements/NavNode.vue","../../../../../../../app/composables/useLanguage.js","../../../../../../../app/components/widgets/MenuMobile.vue","../../../../../../../app/components/shell/AppHeader.vue","../../../../../../../app/components/shell/AppFooter.vue","../../../../../../../app/layouts/default.vue"],"sourcesContent":["<script setup>\n\n</script>\n\n<template>\n  <div class=\"overlay\" /> \n</template>\n\n<style lang=\"scss\">\n  .overlay {\n    @include mq('desktop') {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background-color: rgba(#0f0f0f, .7);\n      z-index: 1;\n    }\n  }\n</style>","import { defineStore } from 'pinia'\n\nexport const useMenuStore = defineStore('menu', () => {\n  const route = useRoute()\n  \n//---------------------------------------------- STATE ---------------------------------------------------------\n  const isOpen = ref(false)\n  const isDeskHide = ref(false)\n\n//---------------------------------------------- ACTIONS ---------------------------------------------------------\n  const toggle = () => {\n    isOpen.value = !isOpen.value\n  }\n  const close = () => {\n    isOpen.value = false\n  }\n  const closeDesk = () => {\n    isDeskHide.value = false\n  }\n\n  //---------------------------------------------- WATCH ---------------------------------------------------------\n  //следит за сменой роута, чтобы закрывать меню при переходе по страницам\n  //следит за открытием/закрытием для блокировки скролла в мобильном меню\n  watch(\n    () => route.fullPath, \n    () => {\n      if (isOpen.value) close()\n      if (isDeskHide.value) closeDesk()\n    }\n  )\n  //следит за открытием/закрытием для блокировки скролла в мобильном меню\n  watch(\n    isOpen, \n    (newValue) => {\n      if (!import.meta.client) return\n      if (newValue) {\n        document.body.style.overflow = 'hidden'\n      } else {\n        document.body.style.overflow = ''\n      }\n    }\n  )\n\n  return { isOpen, toggle, close, isDeskHide }\n})","<script setup>\nimport { NAVIGATION } from '~/constants/navigation'\n\nconst partnerStore = usePartnerStore()\nconst menu = useMenuStore()\nconst route = useRoute()\n\nconst theme = computed(() => route.meta.theme || 'dark')\n\n//Добавление партнеров в массив NAVIGATION\nconst addsPartnerNav = (nav) => {\n  return nav.map((item, index)=> {\n    if (item.id == 1) item.channels = partnerStore?.categoriesWithAssets\n    return item\n  })\n}\n\nconst partnerNav = computed(() => addsPartnerNav(NAVIGATION))\n\nconst onOpen = () => {\n  menu.isDeskHide = true\n}\n\nconst onLeave = () => {\n  menu.isDeskHide = false\n}\n</script>\n\n<template>\n  <div :class=\"`navigation navigation--${theme}`\" @mouseleave=\"onLeave\">\n    <div\n      v-for=\"navItem in partnerNav\" \n      :key=\"navItem.id\" \n      :item=\"navItem\"\n      class=\"navigation__item\"\n      @mouseenter=\"onOpen\"\n    >\n      <Text\n        :to=\"navItem.slug\"\n        :target=\"navItem.external ? '_blank' : undefined\"\n        :rel=\"navItem.external ? 'noopener noreferrer' : undefined\"\n        :variant=\"$typographyVariant.T_LINKS_20\"\n        :font=\"$font.TTSMALLS_REGULAR\"\n        tag=\"NuxtLinkLocale\"\n        class=\"navigation__link\"\n      > {{ $t(navItem?.name) }}</Text>\n\n      <!--блок появляющийся при наведении-->\n      <div class=\"navigation__deep\" v-if=\"menu.isDeskHide\">\n        <template \n          v-for=\"navItemDeep in navItem?.channels\" \n          :key=\"navItemDeep.id\" \n        >\n        <NuxtLinkLocale \n          :to=\"navItemDeep.static ? navItemDeep.slug : `/business#${navItemDeep.slug}`\"\n          class=\"navigation__link-wrap\"\n        >\n          <Text\n            :variant=\"$typographyVariant.T_LINKS_20\"\n            :font=\"$font.TTSMALLS_REGULAR\"\n            :color=\"$color.GRAY_LINE\"\n            class=\"navigation__count\"\n          >{{ navItemDeep?.assetsCount }}</Text>\n          <Text\n            :variant=\"$typographyVariant.T_LINKS_20\"\n            :font=\"$font.TTSMALLS_REGULAR\"\n            class=\"navigation__link navigation__link--deep\"\n          >{{ navItemDeep.static ? $t(navItemDeep.name) : navItemDeep?.name }}</Text>\n        </NuxtLinkLocale>\n        </template>\n      </div>\n      <!--end блок появляющийся при наведении-->\n\n    </div>\n  </div>\n  <Teleport to=\"#teleports\">\n    <Transition name=\"fade\">\n      <MenuOverlay v-if=\" menu.isDeskHide\"/>\n    </Transition>\n  </Teleport>\n</template>\n\n<style lang=\"scss\" scoped>\n.navigation {\n  display: none;\n  @include mq('desktop') {\n    display: flex;\n    align-self: stretch;\n    align-items: center;\n    margin-left: calc(129/1920 * 100%);\n  }\n  &--light {\n    .navigation__deep {\n      color: var(--color-WHITE);\n    }\n\n  }\n}\n\n.navigation__item {\n  position: relative;\n  display: flex;\n  align-self: stretch;\n  align-items: center;\n  cursor: pointer;\n  overflow: hidden;\n  padding-left: em(15);\n  padding-right: em(15);\n   &::before {\n    content: \"\";\n    position: absolute;\n    left: em(15);\n    bottom: 0;\n    width: calc(100% - em(30));\n    height: em(6);\n    background-color: var(--color-C_2101);\n    transform: translateY(em(7)) scaleY(0);\n    transition: transform .3s ease-in-out;\n  }\n  &--active, &:hover {\n    overflow: visible;\n    &::before {\n      transform: translateY(0) scaleY(1);\n    }\n    .navigation__deep {\n      opacity: 1;\n    }\n  }\n\n  &--light {\n    .navigation__deep {\n      color: var(--color-WHITE);\n    }\n  }\n}\n\n.navigation__deep {\n  position: absolute;\n  top: 100%;\n  padding-top: em(44);\n  width: max-content;\n  opacity: 0;\n  transition: opacity .3s ease-in-out;\n  max-width: em(250);\n}\n\n.navigation__link-wrap {\n  display: block;\n  padding-bottom: em(22);\n}\n\n.navigation__link {\n  display: block;\n  position: relative;\n  &--deep {\n    &:hover {\n      color: var(--color-C_2101);\n      .navigation__text {\n        color: var(--color-C_2101);\n      }\n    }\n  }\n}\n\n.navigation__count {\n  position: absolute;\n  right: calc(100% + em(15));\n  color: var(--color-C_2101);\n}\n\n.fade-enter-active,\n.fade-leave-active {\n  transition: opacity .3s ease;\n}\n\n.fade-enter-from {\n  opacity: 0;\n}\n\n.fade-leave-to {\n  opacity: 0;\n}\n</style>","<script setup>\nconst menu = useMenuStore()\n\nconst route = useRoute()\n\nconst theme = computed(() => route.meta.theme || 'dark')\n</script>\n\n<template>\n  <div \n    :class=\"[\n      'burger', `burger--${theme}`, \n      {'burger--open': menu.isOpen}\n    ]\" \n    @click=\"menu.toggle\" \n  />\n</template>\n\n<style lang=\"scss\" scoped>\n\n.burger {\n  position: relative;\n  z-index: 1;\n  width: em(20);\n  height: em(16);\n  position: relative;\n  box-sizing: border-box;\n  transition: all .3s;\n  margin-right: em(10);\n  cursor: pointer;\n  //overflow: hidden;  \n  &:before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    top: 10%;\n    display: block;\n    height: 2px;\n    background: var(--color-WHITE);;\n    transition: all .5s;\n  }\n  &:after {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 10%;\n    display: block;\n    height: 2px;\n    background: var(--color-WHITE);;\n    transition: transform .5s, width 2s;\n  }\n  &--light {\n    &:before {\n      background: var(--color-BLACK);\n    }\n    &:after {\n      background: var(--color-BLACK);;\n    }\n  }\n  &--open {\n    border: 0;\n    \n    &:before {\n      transform: rotate(45deg);\n      background: var(--color-WHITE);\n      top: 100%;\n      margin-top: -40%;\n      margin-left: 0;\n    }\n    &:after {\n      transform: rotate(-45deg);\n      background: var(--color-WHITE);\n      top: 100%;\n      margin-top: -40%;\n      margin-left: 0;\n    }\n  }\n  @include mq('desktop') {\n    display: none;\n  }\n}\n</style>","<script setup>\nconst props = defineProps({\n  item: { type: Object, required: true },\n  depth: { type: Number, default: 0 }, // для определени уровеня вложенности\n  mode: { type: String, default: 'horizontal' }, // 'horizontal' или 'vertical'\n  classes: { type: String}, // 'horizontal' или 'vertical'\n  links: { type: String}, // 'horizontal' или 'vertical'\n})\n\nconst { locale } = useI18n()\n\nconst route = useRoute()\n\nconst menu = useMenuStore()\n\nconst theme = computed(() => route.meta.theme || 'dark')\n\nconst prefix = `/${locale.value}`\n\nconst isOpenDepth = ref(false)//для вертикального меню\n\nconst isOpenDepthDesc = ref(false)//для вертикального меню\n\nconst toggleDepth = () => {\n  if (props.mode === 'vertical' && props.item.channels) {\n    isOpenDepth.value = !isOpenDepth.value\n  }\n}\nconst setOverlay = (val) => {\n  isOpenDepthDesc.value = val\n}\nconst onEnter = () => {\n  if (props.mode === 'horizontal' && props.item.channels) {\n    setOverlay(true)\n  }\n  //menu.isDesktopMenuOpen = true\n}\nconst onLeave = (depth) => {\n  if (props.mode === 'horizontal' && depth == 0) {\n    //menu.isDesktopMenuOpen = false\n    setOverlay(false)\n  }\n}\n</script>\n\n<template>\n  <div \n    :class=\"[\n      depth > 0 ? `nav-item nav-item--depth-${depth + 1}` : `nav-item nav-item--${theme} is-${mode}`,\n      {'nav-item--active': prefix+item.to == route.path },\n      classes\n    ]\"\n    :style=\"{ paddingLeft: depth > 0 ? '15px' : false }\"\n    @mouseenter=\"onEnter\" \n    @mouseleave=\"onLeave(depth)\"\n  >\n    <!-- Ссылка (без вложенности) -->\n    <Text\n      v-if=\"!item.channels\"\n      tag=\"NuxtLinkLocale\"\n      :to=\"depth > 1 ? `/business/partner/${item?.slug}` : item?.slug\"\n      class=\"nav-link\"\n      :target=\"item.external ? '_blank' : undefined\"\n      :rel=\"item.external ? 'noopener noreferrer' : undefined\"\n      :variant=\"depth > 0 ? $typographyVariant.T_LINKS_20 : $typographyVariant.T_MENU\"\n      :font=\"$font.TTSMALLS_REGULAR\"\n    > {{ $t(item.name) }}</Text>\n\n   <!-- Подменю -->\n    <template v-else>\n      <div class=\"nav-toogle\">\n        <Text\n          tag=\"NuxtLinkLocale\"\n          :to=\" depth > 0 ? links : item.slug\"\n          active-class=\"nav-link--active\"\n          :target=\"item.external ? '_blank' : undefined\"\n          :rel=\"item.external ? 'noopener noreferrer' : undefined\"\n          :variant=\"depth > 0 ? $typographyVariant.T_LINKS_20 : $typographyVariant.T_MENU\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n        > {{ $t(item.name) }}</Text>\n        <button @click=\"toggleDepth\" class=\"nav-toogle-button\" v-if=\"item.channels?.length\">\n          <IconSvg\n            :name=\"$iconName.CROSS_MOB_MENU\" \n            :size=\"[$iconSize.SMALL_CROSS_MOB, $iconSize.SMALL_CROSS]\"\n            class=\"arrow-rotated\" :class=\"{ 'is-rotated': isOpenDepth }\"\n          />\n        </button>\n      </div>\n      <div \n        v-if=\"(mode === 'horizontal' && isOpenDepthDesc) || (mode === 'vertical' && isOpenDepth)\"\n        :class=\"['nav-wrap', `nav-wrap--depth-${(depth+1) + 1}`]\"\n      >\n        <!-- РЕКУРСИЯ: Компонент вызывает сам себя -->\n        <NavNode \n          v-for=\"child in item.channels\" \n          :key=\"child.id\" \n          :item=\"child \" \n          :depth=\"depth + 1\"\n          :mode=\"mode\"\n          :links=\"depth > 0 ? `/business/partner/${child.slug}` : `/business#${child.slug}`\"\n          classes=\"channels-deep\"\n        />\n        <NavNode\n          v-for=\"child in item.assetsDeep\" \n          :key=\"child.id\" \n          :item=\"child\" \n          :depth=\"depth + 1\"\n          :mode=\"mode\"\n          :links=\"`/business/partner/${child.slug}`\"\n          classes=\"assetsDeep\"\n        />\n      </div>\n    </template>\n    <!-- End Подменю -->\n  </div>\n</template>\n\n<style lang=\"scss\" scoped>\n.is-horizontal.nav-item {\n  position: relative;\n  display: flex;\n  align-self: stretch;\n  align-items: center;\n  cursor: pointer;\n  overflow: hidden;\n  padding-left: em(15);\n  padding-right: em(15);\n   &::before {\n    content: \"\";\n    position: absolute;\n    left: em(15);\n    bottom: 0;\n    width: calc(100% - em(30));\n    height: em(6);\n    background-color: var(--color-C_2101);\n    transform: translateY(em(7)) scaleY(0);\n    transition: transform .3s ease-in-out;\n  }\n  &--active, &:hover {\n    overflow: visible;\n    &::before {\n      transform: translateY(0) scaleY(1);\n    }\n    .nav-wrap--depth-2 {\n      opacity: 1;\n    }\n  }\n  &--light {\n    .nav-wrap--depth-2 {\n      color: var(--color-WHITE);\n    }\n  }\n  \n  //первая вложенность\n  .nav-wrap--depth-2 {\n    @include mq('desktop') {\n      position: absolute;\n      top: 100%;\n      left: 0;\n      width: max-content;\n      opacity: 0;\n      transition: opacity .3s ease-in-out;\n      padding-top: em(50);\n    }\n  }\n  .nav-item--depth-2 {\n    @include mq('desktop') {\n      padding-left: em(15)!important;\n      padding-bottom: em(22);\n      &:hover {\n        color: var(--color-C_2101);\n      }\n    }\n  }\n  //End первая вложенность\n}\n\n//стили для мобильного меню\n//отступы\n.is-vertical.nav-item {\n  padding-top: em(30);\n  &:first-child {\n    padding-top: 0;\n  }\n}\n.is-vertical .nav-item {\n  padding-top: em(20);\n  &:first-child {\n    padding-top: em(30);\n  }\n}\n.is-vertical .nav-wrap {\n  margin-bottom: em(15);\n}\n//end отступы\n\n.is-vertical {\n  .nav-toogle {\n    width: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n}\n.nav-toogle-button {\n   @include mq('desktop') {\n    display: none;\n  }\n}\n.arrow-rotated { \n  display: inline-block; \n  transform: rotate(45deg);\n  transition: transform .3s ease;\n}\n.arrow-rotated.is-rotated { \n  transform: rotate(90deg); \n}\n\n.assetsDeep, .channelsDeep {\n  position: relative;\n}\n\n.channels-deep > .nav-wrap {\n  @include mq('desktop') {\n    display: none;\n    position: absolute;\n    left: 0;\n    top: em(27);\n    z-index: 5;\n    width: 300px;\n    background-color: whitesmoke;\n  }\n}\n\n.assetsDeep > .nav-wrap {\n  @include mq('desktop') {\n    display: none;\n    position: absolute;\n    left: 100%;\n    top: em(25);\n    z-index: 5;\n    width: 300px;\n    background-color: whitesmoke;\n  }\n}\n</style>","export const useLanguage = () => {\n  const switchLocalePath = useSwitchLocalePath()\n  const { locale } = useI18n()\n\n  const reloadChangeLang = () => {\n    const nextLocale = locale.value === 'ru' ? 'en' : 'ru'\n    const newPath = switchLocalePath(nextLocale)\n    if (process.client && newPath) {\n      window.location.assign(newPath)\n    }\n  }\n\n  return { reloadChangeLang }\n}","<script setup>\nimport { NAVIGATION } from '~/constants/navigation'\nconst { reloadChangeLang } = useLanguage()\nconst menu = useMenuStore()\nconst route = useRoute()\nconst theme = computed(() => route.meta.theme || 'dark')\n</script>\n\n<template>\n  <Transition name=\"fade-slide\">\n    <div :class=\"`menu-mob-wrap menu-mob-wrap--${theme}`\" v-if=\"menu.isOpen\">\n      <NavNode\n        v-for=\"node in NAVIGATION\" \n        :key=\"node.id\" \n        :item=\"node\"\n        mode=\"vertical\"\n      />\n      <div class=\"menu-mob-item menu-mob-item--lang\">\n        <Text\n          tag=\"a\" \n          href=\"#\"\n          @click.prevent=\"reloadChangeLang\"\n          :variant=\"$typographyVariant.T_MENU\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n        > {{ $t('lang') }} </Text>\n      </div>\n    </div>\n  </Transition>\n</template>\n\n<style lang=\"scss\" scoped>\n.menu-mob-wrap {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100vh;\n  padding-top: em($header-height-mob + 62);\n  background-color: var(--color-BLACK);\n  display: flex;\n  flex-direction: column;\n  //gap: em(30);\n  z-index: 1;\n  padding-left: em(35);\n  padding-right: em(10);\n  color: var(--color-WHITE);\n  overflow: auto;\n  &--light {\n    color: var(--color-WHITE);\n  }\n  @include mq('desktop') {\n    z-index: -1;\n    opacity: 0;\n    display: none;\n  }\n}\n.menu-mob-item {\n  &--lang {\n    margin-top: em(160);\n  }\n}\n\n/* Стили для анимации */\n.fade-slide-enter-active,\n.fade-slide-leave-active {\n  transition: transform 0.4s ease;\n}\n\n.fade-slide-enter-from,\n.fade-slide-leave-to {\n  transform: translateX(-100%); \n}\n</style>\n","<script setup>\nimport { NAVIGATION } from '~/constants/navigation'\n\nconst { locale } = useI18n();\n\nconst route = useRoute()\n\nconst { reloadChangeLang } = useLanguage()\n\nconst menu = useMenuStore()\n\nconst theme = computed(() => route.meta.theme || 'dark')\n\nconst themeColorSvg = computed(() => {\n  const { $color } = useNuxtApp() //для использования в computed\n  if (menu.isOpen && route.meta.theme === 'light') return $color.WHITE \n  if (route.meta.theme === 'light') return $color.BLACK\n  return $color.WHITE\n})\n\n</script>\n\n<template>\n  <header :class=\"[ \n    'header container-full', \n    `header--${theme}`,\n  ]\">\n    <Logo class=\"header__logo\" />\n\n    <MenuDesc />\n    \n    <div class=\"header__search\">\n    <NuxtLinkLocale \n      class=\"header__search-link\" \n      to=\"/search\"\n    >\n      <IconSvg \n        :name=\"$iconName.SEARCH_ICON\" \n        :size=\"[$iconSize.SMALL_MOB, $iconSize.SMALL]\"\n        :color=\"themeColorSvg\"\n      />\n    </NuxtLinkLocale>\n    </div>\n\n    <Text\n      tag=\"a\"\n      href=\"#\"\n      class=\"header__lang hide-mobile\"\n      to=\"/search\"\n      :variant=\"$typographyVariant.T_SMALL_20\"\n      :font=\"$font.TTSMALLS_REGULAR\"\n      @click.prevent=\"reloadChangeLang\"\n    > {{ $t('lang')}} </Text>\n\n    <MenuBurger class=\"header__burger\" />\n  </header>\n\n  <Teleport to=\"#teleports\">\n    <MenuMobile />\n  </Teleport>\n</template>\n\n<style lang=\"scss\" scoped>\n.header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  position: relative;\n  min-height: em($header-height-mob);\n  z-index: 2;\n  @include mq('desktop') {\n    min-height: em($header-height-desc);\n    z-index: 2;\n    &::before {\n      content: \"\";\n      transition: opacity .3s ease;\n      opacity: 0;\n      left: 0;\n      bottom: 0;\n      width: 100%;\n      height: em(1);\n      background-color: var(--color-GRAY_LINE);\n      position: absolute;\n      z-index: 0;\n    }\n  }\n  &--line {\n    @include mq('desktop') {\n      &::before {\n        opacity: 1;\n        left: 0;\n      }\n    }\n  }\n  &--light {\n    @include mq('desktop') {\n      background-color: var(--color-WHITE);\n    }\n  }\n}\n\n.header__logo {\n  position: relative;\n  z-index: 3;\n}\n\n\n.header__lang {\n  @include mq('desktop') {\n    margin-right: em(30);\n  }\n}\n\n.header__search {\n  flex-grow: 1;\n  flex-shrink: 0;\n  flex-basis: auto;\n  text-align: right;\n  margin-right: em(38);\n  line-height: 0;\n  @include mq('desktop') {\n    margin-right: calc(436/1920 * 100%);\n    line-height: auto;\n  }\n}\n\n</style>","<script setup>\n  import { NAVIGATION } from '~/constants/navigation'\n  const { locale } = useI18n();\n\n  const siteStore = useSiteStore()\n \n  // Функция разворачивает channels (только для about)\n  const expandAboutChannels = (nav) => {\n    return nav.flatMap((item) => {\n      if (item.id === 3 && item.channels) {\n        const { channels, ...rest } = item\n        return [rest, ...channels]\n      }\n      return [item]\n    })\n  }\n\n  //для каждой колонки перечисляем какие пункты должны быть\n  const columnNames = [\n    ['menu.business', 'menu.media', 'menu.about'],               \n    ['menu.aboutCsr', 'menu.aboutPriorities', 'menu.aboutHistory'],\n    ['menu.aboutCareer', 'menu.contacts', 'menu.ui']\n  ]\n\n  const flatNav = expandAboutChannels(NAVIGATION)\n  const columns = columnNames.map(itemColumn =>\n    itemColumn.map(name => flatNav.find(item => item.name === name)).filter(Boolean)\n  )\n</script>\n<template>\n  <footer class=\"footer container-full\"\n    itemscope\n    itemtype=\"http://schema.org/WPFooter\"\n  >\n    <div class=\"footer__wrap\">\n      <div class=\"footer__item footer__item--nav\">\n        <div class=\"footer__cell\"\n          v-for=\"(column, idx) in columns\"\n          :key=\"idx\"\n        >\n          <Text\n            v-for=\"item in column\" \n            :key=\"item.id\"\n            tag=\"NuxtLinkLocale\"\n            :to=\"item.slug\"\n            class=\"footer__line\"\n            :variant=\"[$typographyVariant.T_NORMAL_20_MOB, $typographyVariant.T_SMALL_20]\"\n            :font=\"$font.TTSMALLS_REGULAR\"\n          >{{ $t(item.name) }}</Text>\n        </div>\n      </div>\n      <div class=\"footer__item footer__item--contacts\" v-if=\" siteStore?.settingsData\">\n        <Text\n          :variant=\"[$typographyVariant.T_NORMAL_20_MOB, $typographyVariant.T_SMALL_20]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          class=\"footer__line footer__line--address\"\n        >{{ siteStore?.settingsData.address }}</Text>\n        <Text\n          tag=\"a\"\n          :variant=\"[$typographyVariant.T_NORMAL_20_MOB, $typographyVariant.T_SMALL_20]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          href=\"mailto:info@gazprom-media.com\"\n          class=\"footer__line footer__line--mail\"\n        >{{ siteStore?.settingsData.email }}</Text>\n        <Text\n          tag=\"a\"\n          :variant=\"[$typographyVariant.T_NORMAL_20_MOB, $typographyVariant.T_SMALL_20]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          href=\"tel:+7(812)6096959\"\n          class=\"footer__line footer__line--tel\"\n        >{{ siteStore?.settingsData.phone_one }}</Text>\n        <SocialList\n          v-if=\"siteStore?.socialNetworks\"\n          :socials=\"siteStore?.socialNetworks\"\n          :color=\"$color.WHITE\"\n          mode=\"link\"\n          footer\n        />\n      </div>\n      <div class=\"footer__item footer__item--copyright\">\n        <meta itemprop=\"copyrightHolder\" content=\"Газпром-медиа холдинг\" />\n        <Text\n          tag=\"a\"\n          :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SUPER_SMALL_16]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          :href=\"locale == 'ru'\n            ? '/doc/Personal_data_processing_policy_GPMH_WEB_RU.pdf'\n            : '/doc/Personal_data_processing_policy_GPMH_WEB_ENG.pdf'\n          \"\n          target=\"_blank\"\n          class=\"footer__line footer__line--copyright-link\"\n        >Политика обработки персональных данных</Text>\n        <Text\n          :variant=\"[$typographyVariant.T_SMALL_16_MOB, $typographyVariant.T_SUPER_SMALL_16]\"\n          :font=\"$font.TTSMALLS_REGULAR\"\n          class=\"footer__line footer__line--copyright-text\"\n        >\n        <span class=\"footer__сopyright-icon\">©</span>\n        АО «Газпром-Медиа Холдинг» Все права защищены\n        </Text>\n      </div>\n    </div>\n  </footer>\n</template>\n<style lang=\"scss\" scoped>\n.footer {\n  position: relative;\n  z-index: 1;\n  overflow: hidden;\n  background-color: var(--color-FON);\n  color: var(--color-WHITE);\n  border-top: 1px solid var(--color-WHITE_LINE);\n  padding: em(60) 0 em(30);\n  @include mq('desktop') {\n    padding: em(100) 0 em(30);\n  }\n}\n\n.footer__wrap {\n  display: flex;\n  flex-wrap: wrap;\n  padding: 0 em($offset-base-mob) 0 em($offset-base-mob);\n  @include mq('desktop') {\n    padding: 0 em($offset-base-desc) 0 em($offset-base-desc);\n  }\n}\n\n.footer__item {\n  &--nav {\n    width: 100%;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    margin-bottom: em(30);\n    @include mq('desktop') {\n      justify-content: flex-start;\n      width: 77%;\n      margin-bottom: 0;\n    }\n  }\n  &--contacts {\n    width: 100%;\n    margin-bottom: em(40);\n    max-width: em(300);\n    @include mq('desktop') {\n      width: 23%;\n      margin-bottom: em(0);\n    }\n  }\n  &--copyright {\n    width: 100%;\n    @include mq('desktop') {\n      margin-top: em(145);\n    }\n  }\n}\n\n.footer__cell {\n  width: calc(50% - em(15));\n  @include mq('desktop') {\n    width: auto;\n    margin-right: 8.2%;\n  }\n} \n\n.footer__line {\n  display: block;\n  margin-bottom: em(10);\n  &--copyright-link {\n    display: inline-block;\n    text-decoration: underline;\n    @include mq('desktop') {\n      text-decoration: none;\n      border-bottom: 1px solid var(--color-WHITE);\n    }\n  }\n  &--tel {\n    margin-bottom: em(18);\n  }\n  &--copyright-text {\n    display: flex;\n    gap: em(10);\n    max-width: em(250);\n    @include mq('desktop') {\n      max-width: em(250);\n      text-decoration: none;\n      margin-bottom: 0;\n    }\n  }\n}\n\n\n</style>","<script setup>\nconst route = useRoute()\nconst theme = computed(() => route.meta.theme || 'dark')\n//для меню\nconst partnerStore = usePartnerStore()\nawait useAsyncData('partnerDef', () => partnerStore.fetchPartners())\n//для футера\nconst siteStore = useSiteStore()\nawait useAsyncData('settingsDef', () => siteStore.fetchSettings())\n</script>\n\n<template>\n<div :class=\"['layout', `layout--${theme}`]\">\n  <AppHeader />\n  <main class=\"layout__content\">\n    <slot />\n  </main>\n  <AppFooter />\n</div>\n</template>\n\n"],"version":3}